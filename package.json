  "scripts": {
    "prepublishOnly": "node scripts/no-npm-publish.mjs",
    "build:pages": "node scripts/pages.mjs",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "test": "node scripts/check.mjs",
    "test:package": "node scripts/package-check.mjs",
    "check:metadata": "node scripts/delivery.mjs metadata",
    "test:delivery": "node scripts/delivery.mjs check",
    "verify:delivery": "node scripts/delivery.mjs verify",
    "check:release": "node scripts/delivery.mjs release",
    "docs:reference": "node scripts/reference.mjs write",
    "check:reference": "node scripts/reference.mjs check",
    "test:guide": "node scripts/guide-check.mjs",
    "docs:build": "node scripts/docs-build.mjs",
    "docs:preview": "node scripts/docs-preview.mjs",
    "check:docs": "node scripts/docs-check.mjs",
    "test:management": "node --test --test-timeout=15000 tests/management-contract.test.ts tests/management-store.test.ts tests/management.test.ts tests/management-host.test.ts tests/management-failures.test.ts",
    "test:management:browser": "node scripts/management-browser-check.mjs",
    "test:npm": "node --test --test-timeout=60000 tests/npm-package.test.ts tests/npm-management.test.ts tests/npm-registry.test.ts",
    "test:npm:browser": "node scripts/npm-browser-check.mjs",
    "test:docs": "node scripts/docs-browser-check.mjs",
    "test:browser": "node scripts/browser-check.mjs",
    "build:records": "node scripts/records-build.mjs",
    "test:records": "node scripts/records-check.mjs",
    "test:ui": "node scripts/ui-check.mjs",
    "build:ui": "node scripts/ui-workspace-build.mjs",
    "example:ui": "node examples/ui-workspace/run.ts",
    "build:png": "node scripts/png-tool.mjs build",
    "test:png": "node scripts/png-tool.mjs check",
    "example:png": "node scripts/png-serve.mjs",
    "example:records": "node examples/records/run.ts",
    "prepack": "node scripts/build.mjs",
    "example:core": "node examples/core.ts",
    "example:server": "node examples/server.ts"
  },
  "dependencies": {
    "consola": "3.4.2",
    "fastify": "5.12.7",
