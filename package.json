  "private": false,
  "license": "MIT",
  "repository": { "type": "git", "url": "https://github.com/mhdfy1988/cordis-web-framework" },
  "homepage": "https://mhdfy1988.github.io/cordis-web-framework/",
  "type": "module",
  "description": "Cordis 基座的 Web 通用框架：公共核心与独立浏览器、Node 宿主",
  "engines": {
